# Build context is the repository root:
#   docker build -f infra/docker/Dockerfile.api .
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
# pnpm refuses to purge node_modules without a TTY unless it knows it's automated.
ENV CI=true
RUN corepack enable

# Narrow the monorepo to just @acme/api and its workspace dependencies, so a
# change to (say) apps/web can't invalidate this image's install layer.
FROM base AS pruner
WORKDIR /repo
COPY . .
RUN pnpm dlx turbo@2.10.9 prune @acme/api --docker

FROM base AS builder
WORKDIR /repo
# Lockfile + package.json files first: this layer only rebuilds when
# dependencies actually change, not on every source edit.
COPY --from=pruner /repo/out/json/ ./
RUN pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ ./
RUN pnpm turbo run build --filter=@acme/api

# `pnpm deploy` with injected workspace packages produces a genuinely
# self-contained directory: prod-only dependencies plus the workspace packages
# materialised into the virtual store rather than symlinked back at the repo.
#
# The --legacy (symlinked) variant is a much smaller bundle, but its
# workspace symlinks point outside the deploy directory and its packages'
# own dependencies aren't reachable, so it can't stand alone in an image.
RUN pnpm deploy --filter=@acme/api --prod \
  --config.inject-workspace-packages=true /deploy \
  && cp -r packages/db/drizzle /deploy/drizzle

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
# Create the user before copying: a `RUN chown -R` afterwards would rewrite
# every file's metadata and duplicate the whole tree into a second layer
# (worth ~150MB here). `COPY --chown` sets ownership as it writes.
RUN addgroup -S nodejs && adduser -S nodeapp -G nodejs
COPY --from=builder --chown=nodeapp:nodejs /deploy ./
USER nodeapp
EXPOSE 3001
CMD ["node", "dist/main.js"]
