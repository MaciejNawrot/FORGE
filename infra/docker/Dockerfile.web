# Build context is the repository root:
#   docker build -f infra/docker/Dockerfile.web .
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=true
RUN corepack enable

FROM base AS pruner
WORKDIR /repo
COPY . .
RUN pnpm dlx turbo@2.10.9 prune @acme/web --docker

FROM base AS builder
WORKDIR /repo
COPY --from=pruner /repo/out/json/ ./
RUN pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ ./
# API_URL is only read at request time by the rewrite, so it is deliberately
# not baked in here — it comes from the runtime environment.
RUN pnpm turbo run build --filter=@acme/web

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

# Next's standalone output already contains a minimal node_modules with only
# the traced runtime files, so no pnpm install is needed in this stage.
# outputFileTracingRoot is the repo root, so the tree is rooted at the
# workspace and the app entrypoint lands under apps/web/.
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/static ./apps/web/.next/static
# (no apps/web/public yet — add a COPY for it here if you add static assets)

USER nextjs
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
