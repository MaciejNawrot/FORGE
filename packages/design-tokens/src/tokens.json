{
  "palette": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#fafafa" },
      "100": { "$value": "#f5f5f5" },
      "200": { "$value": "#e5e5e5" },
      "300": { "$value": "#d4d4d4" },
      "400": { "$value": "#a3a3a3" },
      "500": { "$value": "#737373" },
      "600": { "$value": "#525252" },
      "700": { "$value": "#404040" },
      "800": { "$value": "#262626" },
      "900": { "$value": "#171717" },
      "950": { "$value": "#0a0a0a" },
      "1000": { "$value": "#000000" }
    },
    "blue": {
      "50": { "$value": "#eff6ff" },
      "100": { "$value": "#dbeafe" },
      "200": { "$value": "#bfdbfe" },
      "300": { "$value": "#93c5fd" },
      "400": { "$value": "#2997ff" },
      "500": { "$value": "#0071e3" },
      "600": { "$value": "#0068d1" },
      "700": { "$value": "#1d4ed8" },
      "800": { "$value": "#1e40af" },
      "900": { "$value": "#1e3a8a" }
    },
    "red": {
      "50": { "$value": "#fef2f2" },
      "100": { "$value": "#fee2e2" },
      "400": { "$value": "#f87171" },
      "500": { "$value": "#ef4444" },
      "600": { "$value": "#dc2626" },
      "700": { "$value": "#b91c1c" }
    },
    "green": {
      "50": { "$value": "#f0fdf4" },
      "100": { "$value": "#dcfce7" },
      "400": { "$value": "#4ade80" },
      "500": { "$value": "#22c55e" },
      "600": { "$value": "#16a34a" }
    },
    "amber": {
      "50": { "$value": "#fffbeb" },
      "100": { "$value": "#fef3c7" },
      "400": { "$value": "#fbbf24" },
      "500": { "$value": "#f59e0b" },
      "600": { "$value": "#d97706" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', system-ui, 'Segoe UI', Roboto, sans-serif"
      },
      "mono": { "$value": "ui-monospace, SFMono-Regular, monospace" }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold": { "$value": "700" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "px": { "$value": "1px" },
    "0_5": { "$value": "0.125rem" },
    "1": { "$value": "0.25rem" },
    "1_5": { "$value": "0.375rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" },
    "32": { "$value": "8rem" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.5rem" },
    "lg": { "$value": "0.75rem" },
    "xl": { "$value": "1rem" },
    "2xl": { "$value": "1.25rem" },
    "full": { "$value": "9999px" }
  },
  "color": {
    "light": {
      "$type": "color",
      "background": { "$value": "{palette.neutral.0}" },
      "foreground": { "$value": "{palette.neutral.950}" },
      "card": { "$value": "{palette.neutral.0}" },
      "cardForeground": { "$value": "{palette.neutral.950}" },
      "border": { "$value": "{palette.neutral.200}" },
      "input": { "$value": "{palette.neutral.200}" },
      "ring": { "$value": "{palette.blue.500}" },
      "primary": { "$value": "{palette.blue.600}" },
      "primaryForeground": { "$value": "{palette.neutral.0}" },
      "secondary": { "$value": "{palette.neutral.100}" },
      "secondaryForeground": { "$value": "{palette.neutral.900}" },
      "muted": { "$value": "{palette.neutral.100}" },
      "mutedForeground": { "$value": "{palette.neutral.500}" },
      "accent": { "$value": "{palette.neutral.100}" },
      "accentForeground": { "$value": "{palette.neutral.900}" },
      "destructive": { "$value": "{palette.red.600}" },
      "destructiveForeground": { "$value": "{palette.neutral.0}" },
      "success": { "$value": "{palette.green.600}" },
      "successForeground": { "$value": "{palette.neutral.0}" },
      "warning": { "$value": "{palette.amber.500}" },
      "warningForeground": { "$value": "{palette.neutral.950}" }
    },
    "dark": {
      "$type": "color",
      "background": { "$value": "{palette.neutral.950}" },
      "foreground": { "$value": "{palette.neutral.50}" },
      "card": { "$value": "{palette.neutral.900}" },
      "cardForeground": { "$value": "{palette.neutral.50}" },
      "border": { "$value": "{palette.neutral.800}" },
      "input": { "$value": "{palette.neutral.800}" },
      "ring": { "$value": "{palette.blue.400}" },
      "primary": { "$value": "{palette.blue.500}" },
      "primaryForeground": { "$value": "{palette.neutral.0}" },
      "secondary": { "$value": "{palette.neutral.800}" },
      "secondaryForeground": { "$value": "{palette.neutral.50}" },
      "muted": { "$value": "{palette.neutral.800}" },
      "mutedForeground": { "$value": "{palette.neutral.400}" },
      "accent": { "$value": "{palette.neutral.800}" },
      "accentForeground": { "$value": "{palette.neutral.50}" },
      "destructive": { "$value": "{palette.red.500}" },
      "destructiveForeground": { "$value": "{palette.neutral.0}" },
      "success": { "$value": "{palette.green.500}" },
      "successForeground": { "$value": "{palette.neutral.950}" },
      "warning": { "$value": "{palette.amber.400}" },
      "warningForeground": { "$value": "{palette.neutral.950}" }
    }
  }
}
