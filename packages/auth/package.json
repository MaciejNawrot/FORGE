{
  "name": "@acme/auth",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo",
    "auth:generate": "pnpm dlx @better-auth/cli@1.4.21 generate --config src/auth.ts --output ../db/src/schema/auth.ts -y"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "better-auth": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
