    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@acme/contracts": "workspace:*",
    "@ts-rest/core": "catalog:"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
