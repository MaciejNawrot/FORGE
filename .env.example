# Repository-root environment.
#
# DATABASE_URL lives here because it is shared: the db tooling
# (`pnpm db:migrate` / `db:seed` / `db:studio`) reads it from this file, and
# it matches what apps/api/.env uses. Keeping one copy avoids the two drifting.
#
# Each app also has its own .env.example for app-specific settings —
# copy those to .env in the app directory as well.

NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/acme_dev
