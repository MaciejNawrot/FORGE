NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/acme_dev
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
BETTER_AUTH_SECRET=dev-secret-change-me-to-a-random-32-char-value
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated extra origins allowed to drive auth (preview deploys,
# tunnels used for testing on a phone). Leave empty for pure localhost dev.
BETTER_AUTH_TRUSTED_ORIGINS=
